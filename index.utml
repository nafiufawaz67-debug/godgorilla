<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>God Gorilla</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{--bg:#0d0620;--card:#1d1140;--card2:#2a1a5e;--gold:#ffc928;--gold2:#fff2a8;--text:#f4f0ff;--muted:#a99ad6;--green:#3ddc84}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;overflow:hidden}
#app{height:100%;display:flex;flex-direction:column;max-width:520px;margin:0 auto}
main{flex:1;overflow-y:auto;padding:14px 16px 8px}
.screen{display:none}
.screen.active{display:block}
#tap.active{display:flex;flex-direction:column;align-items:center;min-height:100%}
h2{margin:6px 0 4px;font-size:22px}
.sub{color:var(--muted);font-size:14px;margin:0 0 14px}
.top{width:100%;display:flex;justify-content:space-between;align-items:center;font-size:14px;color:var(--muted)}
.bal{display:flex;align-items:center;gap:8px;margin:14px 0 8px;font-size:42px;font-weight:900;color:var(--gold2)}
.bal span.ic{font-size:34px}
.league{width:100%;background:var(--card);border-radius:14px;padding:10px 12px}
.lrow{display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px}
.lrow b{color:var(--gold)}
.bar{height:8px;background:#0d0620;border-radius:6px;overflow:hidden}
.bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ff9d00,#ffe36b);border-radius:6px;transition:width .2s}
#coinwrap{flex:1;display:flex;align-items:center;justify-content:center;width:100%;padding:12px 0}
#coin{width:min(72vw,300px);height:min(72vw,300px);border-radius:50%;border:6px solid var(--gold);background:radial-gradient(circle at 50% 40%,#5a2bb5,#1a0b3d 70%);box-shadow:0 0 40px rgba(255,201,40,.45),inset 0 0 30px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;touch-action:none;transition:transform .08s;position:relative}
#coin svg{width:88%;height:88%;pointer-events:none}
.shake{animation:sh .3s}
@keyframes sh{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.fl{position:fixed;font-weight:900;font-size:26px;color:var(--gold2);pointer-events:none;text-shadow:0 2px 6px #000;animation:up .8s ease-out forwards;z-index:20}
@keyframes up{to{transform:translateY(-90px);opacity:0}}
.energy{width:100%;padding:4px 0 6px}
.energy .lrow{font-size:15px}
.card{background:var(--card);border-radius:14px;padding:12px;margin-bottom:10px;display:flex;align-items:center;gap:12px}
.card .ic{font-size:28px}
.card .tx{flex:1}
.card .tx b{display:block;font-size:15px}
.card .tx small{color:var(--muted);font-size:12px}
button{font:inherit;border:0;border-radius:10px;padding:9px 14px;font-weight:700;color:#2a1500;background:linear-gradient(#ffe36b,#ffb300);cursor:pointer}
button:disabled{background:#3a2d66;color:#8d80b8}
button.sec{background:var(--card2);color:var(--text)}
nav{display:flex;background:var(--card);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
nav button{flex:1;background:none;color:var(--muted);font-size:12px;padding:8px 0;border-radius:10px}
nav button.on{background:var(--card2);color:var(--gold2)}
nav button span{display:block;font-size:20px}
.link{background:#0d0620;border-radius:10px;padding:10px;font-size:12px;word-break:break-all;color:var(--gold2);margin:8px 0;-webkit-user-select:text;user-select:text}
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#000c;padding:10px 16px;border-radius:20px;font-size:14px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:30;max-width:85%;text-align:center}
#toast.show{opacity:1}
.note{font-size:12px;color:var(--muted);margin-top:12px}
</style>
</head>
<body>
<div id="app">
<main>
  <section id="tap" class="screen active">
    <div class="top"><span id="uname">Gorilla</span><span>🏆 <b id="league">Baby Gorilla</b></span></div>
    <div class="bal"><span class="ic">🪙</
